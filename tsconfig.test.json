{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "incremental": true,
    "tsBuildInfoFile": ".test-build/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/lib/**/*.ts"],
  "exclude": ["node_modules", "src/lib/store.ts", "src/lib/api.ts"]
}
