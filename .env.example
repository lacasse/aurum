# Copy this file to `.env` and set your own values.
# docker compose reads `.env` automatically for the ${VAR} substitutions below.
# NEVER commit `.env` (it is gitignored). Only commit this `.env.example`.

# --- Postgres ---
# Used by db, app (DATABASE_URL), and backup services. All must match.
POSTGRES_USER=aurum
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=aurum

# --- Auth (session-cookie login) ---
AUTH_USERNAME=admin
# Either AUTH_PASSWORD (plaintext, compared in constant time) or, preferably,
# AUTH_PASSWORD_HASH (scrypt "salt:hash" hex). Generate one with:
#   npm run hash-password  (or: npx tsx scripts/hash-password.ts)
# If AUTH_PASSWORD_HASH is set it takes precedence over AUTH_PASSWORD.
AUTH_PASSWORD=change-me-to-a-strong-password
# AUTH_PASSWORD_HASH=
AUTH_SECRET=change-me-to-a-long-random-secret

# --- Market data API keys ---
# The ticker's exchange suffix decides which provider quotes it: a suffixed
# ticker (XEQT.TO, RETL.NEO) goes to EODHD, a bare one (AAPL, BTC) to Twelve
# Data. Both keys are required.
#
# Twelve Data (free tier): https://twelvedata.com
TWELVEDATA_API_KEY=your_twelvedata_key
# EODHD (free tier, exchange-listed tickers): https://eodhd.com
EODHD_API_KEY=your_eodhd_key
# Hard cap on EODHD calls per UTC day. The free plan allows 20, resetting at
# 00:00 GMT; every call site reserves against this before hitting the API, and
# the count is stored in the database so restarts cannot reset it. Set to 0 to
# stop all EODHD traffic (prices then fall back to the last known value).
# EODHD_DAY_LIMIT=20

# --- Optional tuning (safe defaults are fine) ---
# Calls held back from type-ahead ticker validation, so a field somebody is
# typing into cannot spend the allowance every holding's price depends on.
# EODHD_VALIDATE_RESERVE=5
# Twelve Data is capped on two axes at once; the reserves keep an interactive
# lookup from being starved by a background refresh that arrived first.
# TWELVEDATA_MINUTE_LIMIT=8
# TWELVEDATA_DAY_LIMIT=800
# TWELVEDATA_MINUTE_RESERVE=1
# TWELVEDATA_DAY_RESERVE=100
# Symbols a minute the monthly-history backfill may ask Yahoo for. It has no
# published quota but refuses a burst with 429s that last minutes, so the pace
# is what matters; a first fill of thirty tickers takes a few minutes and is
# never repeated. Set to 0 to disable history fetching entirely.
# PRICE_HISTORY_PER_MINUTE=6
# BACKUP_INTERVAL=21600
# BACKUP_RETENTION=14
# BACKUP_ENCRYPTION_KEY=an-optional-openssl-passphrase-to-encrypt-backups
